# Meritor configuration. Copy to .env (gitignored) and fill in.
# Sibyl Memory is a LOCAL SQLite substrate — there is no API key and no URL.

MERITOR_ENV=development
MEMORY_DRIVER=sibyl
SIBYL_MEMORY_DB=.meritor/meritor.db
SIBYL_TENANT_ID=meritor-credit

# --- Base partner stack (testnet by default) ---
# Base Sepolia = 84532, Base mainnet = 8453.
BASE_CHAIN_ID=84532
BASE_RPC_URL=https://sepolia.base.org
# A key that controls TESTNET funds only. Never put mainnet value behind it.
BASE_PRIVATE_KEY=
# Optional: override USDC address (defaults to Circle's canonical deployment).
USDC_ADDRESS=

# --- Virtuals ACP partner stack ---
# Driven by the @virtuals-protocol/acp-cli toolchain, authenticated separately
# via `npx acp configure`. No key goes here.
